<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Sample automation suite" verbose="1"
       configfailurepolicy="continue" thread-count="2" parallel="tests">

    <listeners>
        <listener class-name="webAutomation.utilities.RetryListener"/>
    </listeners>

    <test name="TC_01 Sample retry web automation test"
          annotations="JDK" enabled="true" >
        <classes>
            <class name="webAutomation.testcases.SampleRetryWebTest"/>
        </classes>
    </test>

</suite>